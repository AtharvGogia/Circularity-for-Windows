<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console harness that runs the real conversion engine against sample files generated
       with FFmpeg. No test framework. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Circularity\Circularity.csproj" />
  </ItemGroup>

  <!-- Files the bundled FFmpeg can read but not write (HEIC, AVIF, Apple audio), made once and kept here. -->
  <ItemGroup>
    <None Include="Samples\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
