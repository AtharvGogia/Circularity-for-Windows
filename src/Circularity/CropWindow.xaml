<Window x:Class="Circularity.CropWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ThemeMode="System">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="SizeText" DockPanel.Dock="Right" VerticalAlignment="Center" Opacity="0.75" Margin="16,0,0,0" />
            <WrapPanel x:Name="RatioPanel" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Opacity="0.6"
                       Text="Drag the corners or edges, or draw a new box." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="Skip this file" MinWidth="96" Margin="16,0,8,0" Click="Skip_Click" Visibility="Collapsed" />
                <Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button Content="Crop" IsDefault="True" MinWidth="96" Click="Crop_Click" />
            </StackPanel>
        </DockPanel>

        <!-- The margin and unclipped overlay leave room for the handles when the box is at the image's edge. -->
        <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
            <Image x:Name="Picture" Stretch="Fill" />
            <Canvas x:Name="Overlay" Background="Transparent" Cursor="Cross" />
        </Grid>
    </DockPanel>
</Window>
