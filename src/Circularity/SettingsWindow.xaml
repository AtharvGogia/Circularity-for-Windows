<Window x:Class="Circularity.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circularity settings"
        Width="940" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Live preview over a colourful backdrop, so the transparency setting is visible. -->
        <StackPanel VerticalAlignment="Top" Width="400">
        <Border Width="400" Height="400" CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF5B7FD6" Offset="0" />
                    <GradientStop Color="#FF9C5BD6" Offset="0.5" />
                    <GradientStop Color="#FF2A9D8F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Rectangle Width="150" Height="96" RadiusX="8" RadiusY="8" Fill="#40FFFFFF"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,40,0,0" />
                <Rectangle Width="120" Height="140" RadiusX="8" RadiusY="8" Fill="#30FFFFFF"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,36" />
                <!-- Scaled down only if the chosen wheel size (plus its "More" arc) is bigger than the box. -->
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="6">
                    <ContentPresenter x:Name="PreviewHost" />
                </Viewbox>
            </Grid>
        </Border>
        <WrapPanel Margin="2,12,0,0">
            <TextBlock Text="Preview as" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,14,0" />
            <RadioButton x:Name="PreviewImage" Content="Image" GroupName="PreviewKind" IsChecked="True" MinWidth="0" Margin="0,0,14,0" />
            <RadioButton x:Name="PreviewVideo" Content="Video" GroupName="PreviewKind" MinWidth="0" Margin="0,0,14,0" />
            <RadioButton x:Name="PreviewAudio" Content="Audio" GroupName="PreviewKind" MinWidth="0" Margin="0,0,14,0" />
            <RadioButton x:Name="PreviewDocument" Content="Document" GroupName="PreviewKind" MinWidth="0" />
        </WrapPanel>
        <TextBlock Text="Hover and click the wheel to try it." Opacity="0.6" Margin="2,6,0,0" />
        </StackPanel>

        <DockPanel Grid.Column="1" Margin="32,0,0,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Reset to defaults" Click="Reset_Click" Margin="0,0,8,0"
                        ToolTip="Everything except your saved wheel buttons and start-at-sign-in." />
                <Button Content="Done" Click="Done_Click" IsDefault="True" MinWidth="96" />
            </StackPanel>

            <!-- A fixed height, so switching tabs doesn't resize the window. -->
            <TabControl x:Name="Tabs" Height="500">
                <TabItem Header="Wheel">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,12,12,8">
                            <TextBlock Text="Theme" Margin="0,0,0,4" />
                            <WrapPanel>
                                <RadioButton x:Name="SystemTheme" Content="Same as Windows" GroupName="Theme" MinWidth="0" Margin="0,0,20,0" />
                                <RadioButton x:Name="LightTheme" Content="Light" GroupName="Theme" MinWidth="0" Margin="0,0,20,0" />
                                <RadioButton x:Name="DarkTheme" Content="Dark" GroupName="Theme" MinWidth="0" />
                            </WrapPanel>

                            <TextBlock Text="Size" Margin="0,16,0,4" />
                            <DockPanel>
                                <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                                <Slider x:Name="SizeSlider" Minimum="200" Maximum="360" TickFrequency="10" IsSnapToTickEnabled="True" />
                            </DockPanel>

                            <TextBlock Text="Background opacity" Margin="0,16,0,4" />
                            <DockPanel>
                                <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                                <Slider x:Name="OpacitySlider" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
                            </DockPanel>

                            <TextBlock Text="Accent colour" Margin="0,16,0,8" />
                            <WrapPanel x:Name="Swatches" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="ButtonsTab" Header="Buttons">
                    <DockPanel Margin="4,12,4,4">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="ButtonsHeading" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,10"
                                       Text="Buttons higher up get a place on the wheel first; the rest go behind More. Buttons that open a window (Resize, Crop, Compress) always sit to the left of More." />
                        </StackPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button x:Name="ResetOrderButton" DockPanel.Dock="Right" Content="Reset order" Click="ResetOrder_Click" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="To add your own buttons, tick “Also add this as a button on the wheel” in the Resize or Compress window." />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ButtonList" />
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,12,12,8">
                            <TextBlock Text="Gestures" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="While dragging a file with the left button:" Opacity="0.75" Margin="0,0,0,8" />
                            <CheckBox x:Name="RightClickCheck" Content="Press the right mouse button" />
                            <CheckBox x:Name="ShiftCheck" Content="Press Shift (works on touchpads)" Margin="0,4,0,0" />
                            <CheckBox x:Name="HotkeyCheck" Content="Ctrl+Alt+C opens the wheel for selected files" Margin="0,12,0,0" />

                            <TextBlock Text="Notifications" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
                            <CheckBox x:Name="NotifyFinishCheck" Content="When a conversion finishes" />
                            <CheckBox x:Name="NotifyStartCheck" Content="When Circularity starts" Margin="0,4,0,0" />
                            <TextBlock Text="Problems are always shown." Opacity="0.65" Margin="0,6,0,0" />

                            <TextBlock Text="Startup" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
                            <CheckBox x:Name="StartupCheck" Content="Start Circularity when I sign in to Windows" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Features">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,12,12,8">
                            <TextBlock Text="After conversion" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <CheckBox x:Name="CopyClipboardCheck" Content="Copy converted file(s) to clipboard" />
                            <TextBlock Text="The file itself is copied (like Ctrl+C in File Explorer), so you can paste it directly into another folder or app." Opacity="0.7" Margin="18,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="AboutTab" Header="About">
                    <DockPanel Margin="4,12,4,4">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="What Circularity found on this PC" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,10"
                                       Text="If something isn't working, “Copy diagnostics” puts this list and the end of the log on the clipboard, ready to paste into a bug report." />
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button x:Name="CopyDiagnosticsButton" Content="Copy diagnostics" Click="CopyDiagnostics_Click" Margin="0,0,8,0" />
                            <Button Content="Open log" Click="OpenLog_Click" Margin="0,0,8,0" />
                            <TextBlock x:Name="CopiedText" Text="Copied." VerticalAlignment="Center" Opacity="0.7" Visibility="Collapsed" />
                        </WrapPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DiagnosticsList">
                                <TextBlock Text="Checking…" Opacity="0.7" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>

        <DockPanel VerticalAlignment="Bottom" Width="400" HorizontalAlignment="Left" Margin="2,0,0,6">
            <Button DockPanel.Dock="Right" Content="Check for updates" Click="CheckForUpdates_Click" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                <TextBlock Opacity="0.7" Margin="0,2,0,0">
                    <Run Text="Made by Atharv Gogia · " />
                    <Hyperlink Click="SourceCode_Click">Open source on GitHub</Hyperlink>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
