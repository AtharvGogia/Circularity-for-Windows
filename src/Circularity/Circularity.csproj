<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version gives access to Windows Runtime APIs (toast notifications and the like). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- WPF and WinForms both define Application, MessageBox, etc., so keep usings explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 wants DPI mode set through the WinForms API; this is a WPF app, so the manifest is correct.
         WPF0001 marks Window.ThemeMode (the Windows 11 Fluent theme) as experimental. -->
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
    <RootNamespace>Circularity</RootNamespace>
    <ApplicationIcon>Assets\Circularity.ico</ApplicationIcon>
    <!-- Ship only English UI resources: drops a dozen translation folders from the bundled runtime. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Don't copy packages' XML documentation next to the app. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- Shown in Explorer under the exe's Properties → Details. -->
  <PropertyGroup>
    <Product>Circularity</Product>
    <AssemblyTitle>Circularity</AssemblyTitle>
    <Description>A file converter that lives at your cursor.</Description>
    <Authors>Atharv Gogia</Authors>
    <Company>Atharv Gogia</Company>
    <Copyright>© 2026 Atharv Gogia</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AtharvGogia/Circularity-for-Windows</RepositoryUrl>
    <Version>0.5.0</Version>
    <!-- For HeifWriter's one direct COM call (the HEIC quality setting). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep the version plain (e.g. "0.2.0") instead of appending the git commit id. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EngineSmokeTest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- PDFium (the PDF engine in Chrome), prebuilt: renders PDF pages to images on the CPU. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8086" />
    <!-- SVG rendering via SkiaSharp -->
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

  <!-- SkiaSharp's native libraries come with their debug symbols (over 100 MB), which only matter for
       debugging Skia itself, so they're left out of the published app. -->
  <Target Name="LeaveOutNativeDebugSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' and ($([System.String]::Copy('%(Filename)').StartsWith('libSkiaSharp')) or $([System.String]::Copy('%(Filename)').StartsWith('libHarfBuzzSharp')))" />
    </ItemGroup>
  </Target>

</Project>
