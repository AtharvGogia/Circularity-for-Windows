<Window x:Class="Circularity.ResizeDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resize"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ThemeMode="System">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SubHeading" Opacity="0.7" Margin="0,4,0,20" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <TextBlock Text="Width" Opacity="0.8" Margin="0,0,0,4" />
                <TextBox x:Name="WidthBox" Width="110" />
            </StackPanel>
            <TextBlock Text="×" VerticalAlignment="Bottom" Margin="10,0,10,8" />
            <StackPanel>
                <TextBlock Text="Height" Opacity="0.8" Margin="0,0,0,4" />
                <TextBox x:Name="HeightBox" Width="110" />
            </StackPanel>
            <TextBlock Text="px" VerticalAlignment="Bottom" Margin="8,0,0,8" />
        </StackPanel>
        <CheckBox x:Name="KeepAspect" Content="Keep aspect ratio" IsChecked="True" Margin="0,12,0,0" />

        <TextBlock x:Name="ResultText" Margin="0,16,0,0" Opacity="0.8" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="Resize" IsDefault="True" MinWidth="96" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
