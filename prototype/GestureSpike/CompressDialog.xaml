<Window x:Class="GestureSpike.CompressDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compress"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ThemeMode="System">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SubHeading" Opacity="0.7" Margin="0,4,0,20" TextWrapping="Wrap" />

        <WrapPanel Margin="0,0,0,14">
            <RadioButton x:Name="QualityMode" Content="Quality" GroupName="Mode" IsChecked="True" Margin="0,0,20,0" />
            <RadioButton x:Name="SizeMode" Content="Target file size" GroupName="Mode" />
        </WrapPanel>

        <StackPanel x:Name="QualityPanel">
            <DockPanel>
                <TextBlock x:Name="QualityText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider x:Name="QualitySlider" Minimum="10" Maximum="100" Value="80" TickFrequency="5" IsSnapToTickEnabled="True" />
            </DockPanel>
            <TextBlock Text="Lower is smaller. Around 75–85% looks the same as the original for most photos."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel x:Name="SizePanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SizeBox" Width="100" Text="500" />
                <ComboBox x:Name="UnitBox" Width="80" Margin="8,0,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="KB" />
                    <ComboBoxItem Content="MB" />
                </ComboBox>
            </StackPanel>
            <WrapPanel x:Name="SizePresets" Margin="0,10,0,0" />
            <TextBlock x:Name="SizeHint" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <TextBlock x:Name="AlphaNote" Margin="0,16,0,0" Opacity="0.8" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="Saved as JPG, so any transparent areas become white." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="Compress" IsDefault="True" MinWidth="96" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
