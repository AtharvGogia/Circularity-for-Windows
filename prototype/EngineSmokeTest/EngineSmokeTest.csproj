<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console harness that runs the real conversion engine against sample files generated
       with FFmpeg. No test framework, so it needs no NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestureSpike\GestureSpike.csproj" />
  </ItemGroup>

</Project>
